---
// A section of an edition page: small label on the left, heading and content on the right.
interface Props {
  id: string;
  label: string;
  title: string;
  intro?: string;
}

const { id, label, title, intro } = Astro.props;
---

<section id={id} class="edition-section" aria-labelledby={`${id}-title`}>
  <div class="container section-grid">
    <p class="eyebrow edition-section__label">{label}</p>
    <div class="edition-section__content">
      <h2 id={`${id}-title`} class="section-title">{title}</h2>
      {intro && <p class="section-intro">{intro}</p>}
      <div class="edition-section__body">
        <slot />
      </div>
    </div>
  </div>
</section>

<style>
  .edition-section {
    padding-block: clamp(3.5rem, 8vw, 6rem);
    border-top: 1px solid var(--border);
  }

  .edition-section:first-of-type {
    border-top: 0;
  }

  .edition-section__label {
    color: var(--edition-accent, var(--accent));
  }

  .edition-section__content {
    min-width: 0;
  }

  .edition-section__body {
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
  }
</style>
