---
// Card linking to an edition's photo gallery hosted elsewhere (Técnico, Google Drive, ...).
interface Props {
  href: string;
  title: string;
  /** Who publishes the gallery and where it opens. */
  text: string;
  label?: string;
}

const { href, title, text, label = 'Photo gallery' } = Astro.props;
---

<a class="gallery-link" href={href} target="_blank" rel="noopener noreferrer">
  <span class="eyebrow">{label}</span>
  <span class="gallery-link__title">{title}</span>
  <span class="gallery-link__text">{text}</span>
  <span class="gallery-link__arrow" aria-hidden="true">↗</span>
  <span class="visually-hidden">(opens in a new tab)</span>
</a>

<style>
  .gallery-link {
    position: relative;
    display: grid;
    gap: 0.5rem;
    padding: 1.5rem 3rem 1.5rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .gallery-link:hover {
    border-color: var(--border-strong);
    background: var(--bg-raised);
  }

  .gallery-link .eyebrow {
    color: var(--edition-accent, var(--accent));
  }

  .gallery-link__title {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .gallery-link__text {
    color: var(--text-muted);
    font-size: 0.9375rem;
  }

  .gallery-link__arrow {
    position: absolute;
    top: 1.25rem;
    right: 1.5rem;
    color: var(--text-subtle);
  }
</style>
