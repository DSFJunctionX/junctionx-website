---
// A self-hosted video with controls. Nothing is downloaded until the visitor presses play.
interface Props {
  src: string;
  poster?: string;
  caption: string;
}

const { src, poster, caption } = Astro.props;
---

<figure class="video-figure">
  <video controls preload="none" playsinline poster={poster}>
    <source src={src} type="video/mp4" />
  </video>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .video-figure {
    margin: 0;
  }

  .video-figure video {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: #000;
  }

  .video-figure figcaption {
    margin-top: 0.75rem;
    color: var(--text-subtle);
    font-size: 0.875rem;
  }
</style>
