  /* Interactive styling for the transport link */
  .transport-link {
    /* Keeps the text color the same as the surrounding text by default */
    color: inherit; 
    text-decoration: none;
    position: relative;
    display: inline-block;
    transition: color 0.2s ease, transform 0.1s ease;
  }

  /* The hidden underline */
  .transport-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 1px;
    /* Uses your theme's purple for the underline */
    background-color: #BDBDFF; 
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s ease;
  }

  /* Hover effect: text turns purple and underline slides in */
  .transport-link:hover {
    color: #BDBDFF;
  }

  .transport-link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  /* Click effect: pushes the text down slightly to feel like a real button press */
  .transport-link:active {
    transform: translateY(2px) scale(0.98);
