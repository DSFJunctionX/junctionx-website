---
// src/components/sections/Team.astro
const team = [
  { name: "Daniel Borges", role: "Lead Organizer", image: "/junctionx-website/assets/team/daniel.jpeg", linkedin: "https://www.linkedin.com/in/daniel-borgs/" },
  { name: "Duarte Pereira da Cruz", role: "Lead Organizer", image: "/junctionx-website/assets/team/duarte.jpg", linkedin: "https://www.linkedin.com/in/duartepcruz/" }, 
  { name: "Clara Domingos", role: "Organizer", image: "/junctionx-website/assets/team/clara.png", linkedin: "https://www.linkedin.com/in/clara-domingos/" },
  { name: "Constança Moreira", role: "Marketing", image: "/junctionx-website/assets/team/constanca.jpg", linkedin: "https://www.linkedin.com/in/constancafernandesmoreira/" },
  { name: "Matilde Figueiredo", role: "Marketing", image: "/junctionx-website/assets/team/matilde.jpg", linkedin: "https://www.linkedin.com/in/matilde-figueiredo-3708753b4/" },
  { name: "Salvador Pereira", role: "Organizer", image: "/junctionx-website/assets/team/salvador.png", linkedin: "https://www.linkedin.com/in/salvador-pereira-78a0ba204/" },
  { name: "Vicente Santos", role: "Organizer", image: "/junctionx-website/assets/team/vicente.jpg", linkedin: "https://www.linkedin.com/in/vicente-de-lemos-santos/" },
  { name: "Vasco Reino", role: "Organizer" },
];
---

<section id="our-team" class="team-section">
  <div class="full-screen-separator"></div>
  <div class="container">
    <h2 class="h2 h2--light-purple">OUR TEAM</h2>

    <div class="team-grid">
      {team.map((member) => (
        <a 
          href={member.linkedin} 
          target="_blank" 
          rel="noopener noreferrer"
          class={`team-card ${!member.image ? 'team-card--text-only' : ''}`}
        >
          {member.image && (
            <div class="team-card__image-wrapper">
              <img src={member.image} alt={member.name} loading="lazy" />
            </div>
          )}
          <div class="team-card__info">
            <h3 class="team-card__name">{member.name}</h3>
            <p class="team-card__role">{member.role}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .team-section {
    position: relative;
    background-color: transparent;
    color: #ffffff;
    padding-bottom: clamp(60px, 10vw, 120px);
    padding-top: 0;
  }

  .full-screen-separator {
    width: 100%;
    height: 1px;
    background: rgba(189, 189, 255, 0.2);
    margin-bottom: clamp(40px, 6vw, 80px);
  }

  .container {
    max-width: 1050px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 40px);
  }

  .eyebrow {
    color: #BDBDFF;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 24px;
    margin-top: 2rem; /* Added this to keep the spacing since we removed the custom h2 margin */
  }

  .team-card {
    background: #111111;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 20px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-decoration: none; 
    color: inherit; 
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .team-card:hover {
    transform: translateY(-6px);
    border-color: rgba(189, 189, 255, 0.2);
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.4);
  }
  
  .team-card:active {
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
  }

  .team-card__image-wrapper {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #1a1a1a;
  }

  .team-card__image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .team-card:hover .team-card__image-wrapper img {
    transform: scale(1.05);
  }

  .team-card__info {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex-grow: 1;
    justify-content: center;
  }

  .team-card--text-only {
    justify-content: center;
    align-items: center;
    text-align: center;
    min-height: 180px; 
    background: linear-gradient(145deg, #111111 0%, #1a1a2e 100%);
    border: 1px solid rgba(189, 189, 255, 0.15);
  }

  .team-card--text-only .team-card__name {
    font-size: 1.5rem;
  }

  .team-card__name {
    font-family: monospace;
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
  }

  .team-card__role {
    font-size: 0.9rem;
    color: #BDBDFF;
    margin: 0;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }
</style>