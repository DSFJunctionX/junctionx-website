---
// src/components/Sponsors.astro
const mysteryTexts = Array(8).fill("TO BE ANNOUNCED");
---

<!-- Add id="sponsors" right here! -->
<section id="sponsors" class="Sponsors">
  <div class="container">
    <h2 class="h2 h2--light-purple">Sponsors</h2>
  </div>

  <div class="Sponsors__track-wrapper">
    <div class="Sponsors__track">
      <div class="Sponsors__group">
        {mysteryTexts.map((text) => (
          <div class="sponsors__mystery-text">{text}</div>
        ))}
      </div>

      <div class="Sponsors__group" aria-hidden="true">
        {mysteryTexts.map((text) => (
          <div class="sponsors__mystery-text">{text}</div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .Sponsors {
    background: #171717;
    /* Reduced padding here to match the tightened spacing from Prizes */
    padding-block: clamp(40px, 5vw, 60px);
    overflow: hidden;
  }

  .container {
    max-width: 1050px; 
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 40px);
  }

  .Sponsors__track-wrapper {
    width: 100%;
    overflow: hidden;
    margin-top: 40px;
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0%,
      #000 10%,
      #000 90%,
      transparent 100%
    );
    mask-image: linear-gradient(
      90deg,
      transparent 0%,
      #000 10%,
      #000 90%,
      transparent 100%
    );
  }

  .Sponsors__track {
    display: flex;
    width: max-content;
    /* Sped up the scroll slightly since it's text, not large images */
    animation: scroll 20s linear infinite; 
  }

  .Sponsors__group {
    display: flex;
    align-items: center;
    gap: 80px;
    flex-shrink: 0;
    padding-right: 80px;
  }

  @keyframes scroll {
    to {
      transform: translateX(calc(-40% / 2));
    }
  }

  .Sponsors__track:hover {
    animation-play-state: paused;
  }

  /* New styling for the mystery text instead of logos */
  .sponsors__mystery-text {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 800;
    color: #BDBDFF;
    opacity: 0.4;
    letter-spacing: 4px;
    font-family: monospace;
    text-transform: uppercase;
    transition: opacity 0.3s ease;
  }

  .sponsors__mystery-text:hover {
    opacity: 1;
  }
</style>