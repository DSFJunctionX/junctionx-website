---
// src/components/Sponsors.astro

// Set `revealed: true` for any sponsor to replace the "?" with their logo and name
const tiers = [
  {
    level: "very-high",
    items: [
      { name: "NOS", logo: "/assets/nos.png", revealed: false },
    ],
  },
  {
    level: "high",
    items: [
      { name: "Sensei", logo: "/assets/sensei.png", revealed: false },
      { name: "Inspiring Solutions", logo: "/assets/inspiring-solutions.png", revealed: false },
    ],
  },
  {
    level: "basic",
    items: [
      { name: "Albatroz Engenharia", logo: "/assets/albatroz-engenharia.png", revealed: false },
      { name: "Jane Street", logo: "/assets/jane-street.jpg", revealed: false },
      { name: "Lovable", logo: "/assets/lovable.png", revealed: false },
      { name: "n8n", logo: "/assets/n8n.svg", revealed: true },
    ],
  },
];
---

<section id="sponsors" class="Sponsors">
  <div class="container">
    <h2 class="h2 h2--light-purple">Sponsors</h2>

    <div class="Sponsors__tiers">
      {tiers.map((tier) => (
        <div class={`Sponsors__grid Sponsors__grid--${tier.level}`}>
          {tier.items.map((sponsor) => (
            <div class={`Sponsors__box Sponsors__box--${tier.level}`}>
              {sponsor.revealed ? (
                <div class="Sponsors__revealed">
                  <img src={sponsor.logo} alt={`${sponsor.name} logo`} class="Sponsors__logo" />
                  <span class="Sponsors__name">{sponsor.name}</span>
                </div>
              ) : (
                <div class="Sponsors__mystery">?</div>
              )}
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .Sponsors {
    background: #171717;
    padding-block: clamp(40px, 5vw, 60px);
    overflow: hidden;
  }

  .container {
    max-width: 1050px; 
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 40px);
  }

  .h2--light-purple {
    color: #BDBDFF;
    text-align: center;
    margin-bottom: 40px;
  }

  .Sponsors__tiers {
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 100%;
  }

  /* Grid Layouts for different tiers */
  .Sponsors__grid {
    display: grid;
    gap: 24px;
    width: 100%;
  }

  .Sponsors__grid--very-high {
    grid-template-columns: 1fr;
  }

  .Sponsors__grid--high {
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  }

  .Sponsors__grid--basic {
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }

  /* Box Styling */
  .Sponsors__box {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(189, 189, 255, 0.1);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .Sponsors__box:hover {
    transform: translateY(-4px);
    border-color: rgba(189, 189, 255, 0.3);
  }

  /* Box Heights based on tier */
  .Sponsors__box--very-high {
    min-height: 240px;
  }

  .Sponsors__box--high {
    min-height: 180px;
  }

  .Sponsors__box--basic {
    min-height: 140px;
  }

  /* Mystery Question Mark State */
  .Sponsors__mystery {
    font-size: clamp(3rem, 5vw, 5rem);
    font-weight: 800;
    color: #BDBDFF;
    opacity: 0.3;
    font-family: monospace;
    transition: opacity 0.3s ease;
  }

  .Sponsors__box:hover .Sponsors__mystery {
    opacity: 0.8;
  }

  /* Revealed State */
  .Sponsors__revealed {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 24px;
  }

  .Sponsors__logo {
    max-width: 100%;
    max-height: 100px;
    object-fit: contain;
  }

  .Sponsors__box--very-high .Sponsors__logo {
    max-height: 140px;
  }

  .Sponsors__box--basic .Sponsors__logo {
    max-height: 70px;
  }

  .Sponsors__name {
    color: #FFFFFF;
    font-weight: 600;
    font-size: 1.1rem;
    letter-spacing: 0.5px;
    text-align: center;
  }

  /* Mobile responsiveness adjustments */
  @media (max-width: 600px) {
    .Sponsors__grid--high,
    .Sponsors__grid--basic {
      grid-template-columns: 1fr 1fr;
    }
    
    .Sponsors__box--very-high { min-height: 180px; }
    .Sponsors__box--high { min-height: 140px; }
    .Sponsors__box--basic { min-height: 100px; }
    
    .Sponsors__name {
      font-size: 0.9rem;
    }
  }
</style>