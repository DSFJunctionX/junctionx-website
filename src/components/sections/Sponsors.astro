---
// src/components/sections/Sponsors.astro

const tiers = [
  {
    level: "premium",
    items: [
      { name: "NOS", logo: "/assets/sponsors/nos.png", website: "https://www.nos.pt/en/welcome", revealed: false },
    ],
  },
  {
    level: "main",
    items: [
      { name: "Sensei", logo: "/assets/sponsors/sensei.png", website: "https://www.sensei.tech/", revealed: false },
      { name: "Inspiring Solutions", logo: "/assets/sponsors/inspiring-solutions.png", website: "https://inspiringsolutions.pt/en/home-english/", revealed: false },
    ],
  },
  {
    level: "standard",
    items: [
      { name: "Albatroz Engenharia", logo: "/assets/sponsors/albatroz-engenharia.png", website: "https://albatroz-eng.com/", revealed: false},
      { name: "MongoDB", logo: "/assets/sponsors/mongodb.png", website: "https://www.mongodb.com/", revealed: false },
      { name: "Jane Street", logo: "/assets/sponsors/jane-street.jpg", website: "https://www.janestreet.com/", revealed: true },
      { name: "Lovable", logo: "/assets/sponsors/lovable.png", website: "https://lovable.dev/", revealed: true },
      { name: "n8n", logo: "/assets/sponsors/n8n.svg", website: "https://n8n.io", revealed: true },
      { name: "SSOJet", logo: "/assets/sponsors/ssojet.png", website: "https://ssojet.com/", revealed: true },
    ],
  },
];
---

<section id="sponsors" class="Sponsors">
  <div class="container">
    <h2 class="h2 h2--light-purple">Sponsors</h2>

    <div class="Sponsors__wall">
      {tiers.map((tier) => (
        <div class={`Sponsors__grid Sponsors__grid--${tier.level}`}>
          {tier.items.map((sponsor) => (
            <div class={`Sponsors__box Sponsors__box--${tier.level} ${sponsor.revealed ? 'is-revealed' : 'is-mystery'}`}>
              {sponsor.revealed ? (
                <div class="Sponsors__revealed">
                  {sponsor.website ? (
                    <a
                      href={sponsor.website}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="Sponsors__link"
                      aria-label={`Visit ${sponsor.name} website`}
                    >
                      <img src={sponsor.logo} alt={`${sponsor.name} logo`} class="Sponsors__logo" />
                    </a>
                  ) : (
                    <div class="Sponsors__link">
                      <img src={sponsor.logo} alt={`${sponsor.name} logo`} class="Sponsors__logo" />
                    </div>
                  )}
                </div>
              ) : (
                <div class="Sponsors__mystery">?</div>
              )}
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .Sponsors {
    background-color: transparent; /* Matches Team.astro */
    padding-block: clamp(40px, 5vw, 60px);
    overflow: hidden;
  }

  .container {
    max-width: 1050px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 40px);
  }

  .h2--light-purple {
    color: #BDBDFF;
    text-align: center;
    margin-bottom: 40px;
  }

  .Sponsors__wall {
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 100%;
  }

  .Sponsors__grid {
    display: grid;
    gap: 24px;
    width: 100%;
  }

  /* Grid Layouts */
  .Sponsors__grid--premium { grid-template-columns: 1fr; }
  .Sponsors__grid--main { grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
  .Sponsors__grid--standard { grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }

  /* Base Box Styling - perfectly matching Team cards */
  .Sponsors__box {
    background: #111111;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .Sponsors__box:hover {
    transform: translateY(-6px);
    border-color: rgba(189, 189, 255, 0.2);
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.4);
  }

  .Sponsors__box:active {
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
  }

  /* Box Heights */
  .Sponsors__box--premium { min-height: 240px; }
  .Sponsors__box--main { min-height: 180px; }
  .Sponsors__box--standard { min-height: 140px; }

  /* Mystery State - Matches the 'text-only' Team cards */
  .Sponsors__box.is-mystery {
    background: linear-gradient(145deg, #111111 0%, #1a1a2e 100%);
    border: 1px solid rgba(189, 189, 255, 0.15);
  }

  .Sponsors__mystery {
    font-size: clamp(3rem, 5vw, 5rem);
    font-weight: 800;
    color: #BDBDFF;
    opacity: 0.15;
    font-family: monospace;
    transition: opacity 0.3s ease;
  }

  .Sponsors__box:hover .Sponsors__mystery {
    opacity: 0.4;
  }

  /* Revealed State */
  .Sponsors__revealed {
    width: 100%;
    height: 100%;
    display: flex;
  }

  .Sponsors__link {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    text-decoration: none;
  }

  .Sponsors__logo {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  .Sponsors__box:hover .Sponsors__logo {
    transform: scale(1.05);
  }

  /* Logo Sizing */
  .Sponsors__box--premium .Sponsors__logo { max-height: 120px; }
  .Sponsors__box--main .Sponsors__logo { max-height: 80px; }
  .Sponsors__box--standard .Sponsors__logo { max-height: 60px; }

  /* Mobile Adjustments */
  @media (max-width: 600px) {
    .Sponsors__grid--main,
    .Sponsors__grid--standard {
      grid-template-columns: 1fr 1fr;
    }

    .Sponsors__box--premium { min-height: 180px; }
    .Sponsors__box--main { min-height: 140px; }
    .Sponsors__box--standard { min-height: 100px; }
    
    .Sponsors__link { padding: 16px; }
  }
</style>