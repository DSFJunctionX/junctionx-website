---
const challenges = [
  {
    title: "Untrace - Data privacy in the new era",
    summary: "Find and remove sensitive personal data from documents, records and reports.",
    revealed: false,
    sponsor: "NOS",
    logo: "/assets/sponsors/nos.png",
    logoVariant: "nos",
    pdf: "/assets/challenges/nos-data-privacy-challenge.pdf",
  },
  {
    title: "Fresh eyes on fresh produce!",
    summary: "Use store cameras to count produce and check shelf layouts against the planogram.",
    revealed: false,
    sponsor: "Sensei",
    logo: "/assets/sponsors/sensei.png",
    logoVariant: "wide",
    pdf: "/assets/challenges/sensei-fresh-produce-challenge.pdf",
  },
  {
    title: "QuantumTrace - Uncovering Cryptographic Debt in the Quantum Dawn",
    summary: "Find quantum-vulnerable cryptography across code, network traffic and cloud environments.",
    revealed: false,
    sponsor: "Inspiring Solutions",
    logo: "/assets/sponsors/inspiring-solutions.png",
    logoVariant: "wide",
    pdf: "/assets/challenges/inspiring-solutions-quantumtrace-challenge.pdf",
  },
  {
    title: "Am I at a unique place? Where in the world could here be?",
    summary: "Use AI agents to identify where a 360º panorama was taken.",
    revealed: false,
    sponsor: "Albatroz Engenharia",
    logo: "/assets/sponsors/albatroz-engenharia.png",
    logoVariant: "square",
    pdf: "/assets/challenges/albatroz-unique-place-challenge.pdf",
  },
];
---

<section id="challenges" class="challenge-page">
  <div class="challenge-page__inner">
    <div class="section-head">
      <h2 class="h2 h2--light-purple">Challenges</h2>
      <p class="lead">
        Choose a project that inspires your team and turn bold ideas into real-world impact.
      </p>
    </div>

    <div class="carousel" id="carousel">
      <button class="carousel__btn carousel__btn--prev" aria-label="Previous challenge" type="button">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
      </button>

      <div class="carousel__viewport">
        <div class="challenge-grid" id="carousel-track">
          {challenges.map((c, index) => (
            <article
              class:list={["challenge-card", c.revealed && "challenge-card--revealed"]}
              data-challenge-index={index}
            >
              {c.revealed && (
                <a
                  class="challenge-card__link"
                  href={c.pdf}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Open the full description of ${c.title} (PDF)`}
                />
              )}
              <div class="challenge-card__head">
                <h2>{c.title}</h2>
                <img
                  class:list={["challenge-card__logo", `challenge-card__logo--${c.logoVariant}`]}
                  src={c.logo}
                  alt={`${c.sponsor} logo`}
                  draggable="false"
                />
              </div>
              <p>{c.summary}</p>
            </article>
          ))}
        </div>
      </div>

      <div class="carousel__pagination" aria-label="Choose a challenge">
        {challenges.map((c, index) => (
          <button
            class="carousel__dot"
            type="button"
            aria-label={`Show challenge ${index + 1}: ${c.sponsor}`}
            aria-current={index === 0 ? "true" : undefined}
            data-carousel-dot={index}
          />
        ))}
      </div>

      <button class="carousel__btn carousel__btn--next" aria-label="Next challenge" type="button">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6" /></svg>
      </button>
    </div>
  </div>
</section>

<style>
  .challenge-page {
    position: relative;
    padding: clamp(48px, 7vw, 96px) 1.25rem;
    color: var(--white);
    background:
      radial-gradient(ellipse at 12% 45%, rgba(88, 101, 242, 0.16), transparent 38%),
      radial-gradient(ellipse at 88% 55%, rgba(189, 189, 255, 0.12), transparent 36%);
  }

  .challenge-page__inner {
    max-width: 1050px;
    margin: 0 auto;
  }

  .section-head {
    max-width: 900px;
    margin: 0 auto 2rem;
    text-align: center;
  }

  .section-head .h2 {
    margin: 0 0 1rem;
  }

  .lead {
    margin: 0 auto;
    max-width: 760px;
    color: var(--muted);
    font-size: clamp(1.1rem, 2vw, 1.25rem);
    line-height: 1.6;
    text-wrap: balance;
  }

  .carousel {
    position: relative;
    padding: 0 3.5rem;
    max-width: 1050px;
    margin: 0 auto;
  }

  .carousel__viewport {
    overflow: hidden;
    padding: 0.75rem 0 1.5rem;
    touch-action: pan-y;
  }

  .challenge-grid {
    --gap: 1.5rem;
    display: flex;
    align-items: flex-start;
    gap: var(--gap);
    will-change: transform;
  }

  .challenge-card {
    flex: 0 0 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    color: inherit;
    text-decoration: none;
    position: relative;
    overflow: hidden;
    min-height: clamp(240px, 20vw, 300px);
    padding: clamp(2rem, 4vw, 3rem);
    border-radius: 20px;
    background: linear-gradient(135deg, #211b3d 0%, #19182e 52%, #14232e 100%);
    border: 1px solid rgba(189, 189, 255, 0.2);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .challenge-card--revealed:hover {
    transform: translateY(-6px);
    border-color: rgba(189, 189, 255, 0.55);
    box-shadow: 0 30px 50px rgba(49, 39, 91, 0.38);
  }

  .challenge-card--revealed:active {
    transform: translateY(-2px);
  }

  .challenge-card__link {
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
  }

  .challenge-card__link:focus-visible {
    outline: 2px solid #bdbdff;
    outline-offset: -4px;
  }

  .challenge-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 1.25rem;
  }

  .challenge-card__logo {
    flex-shrink: 0;
    object-fit: contain;
    user-select: none;
  }

  .challenge-card__logo--wide {
    width: 168px;
    height: 88px;
  }

  .challenge-card__logo--nos {
    width: 176px;
    height: 96px;
    object-fit: cover;
  }

  .challenge-card__logo--square {
    width: 104px;
    height: 104px;
  }

  .challenge-card h2 {
    max-width: 72%;
    margin: 0;
    font-size: clamp(1.5rem, 2.4vw, 2.25rem);
    line-height: 1.25;
    color: var(--white);
    text-wrap: balance;
  }

  .challenge-card p {
    max-width: 780px;
    margin: 0;
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    color: var(--muted);
    line-height: 1.6;
  }

  .carousel__btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid rgba(189, 189, 255, 0.35);
    background: #211b3d;
    box-shadow: 0 8px 20px rgba(22, 18, 42, 0.35);
    color: #fff;
    cursor: pointer;
    transition: background 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
  }
  .carousel__btn:hover {
    background: #332b58;
    border-color: #bdbdff;
    transform: translateY(-50%) scale(1.08);
  }
  .carousel__btn:focus-visible {
    outline: 2px solid #bdbdff;
    outline-offset: 3px;
  }
  .carousel__btn--prev { left: 0; }
  .carousel__btn--next { right: 0; }

  .carousel__pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.65rem;
    padding-top: 0.25rem;
  }

  .carousel__dot {
    width: 10px;
    height: 10px;
    padding: 0;
    border: 1px solid rgba(189, 189, 255, 0.65);
    border-radius: 999px;
    background: rgba(189, 189, 255, 0.18);
    cursor: pointer;
    transition: width 0.25s ease, background 0.25s ease, border-color 0.25s ease;
  }

  .carousel__dot[aria-current="true"] {
    width: 28px;
    background: #bdbdff;
    border-color: #bdbdff;
  }

  .carousel__dot:focus-visible {
    outline: 2px solid #bdbdff;
    outline-offset: 4px;
  }

  @media (max-width: 900px) {
    .carousel { padding: 0; }
    .carousel__btn { width: 42px; height: 42px; }
    .challenge-card__logo--wide { width: 136px; height: 68px; }
    .challenge-card__logo--nos { width: 140px; height: 76px; }
    .challenge-card__logo--square { width: 76px; height: 76px; }
  }

  @media (max-width: 600px) {
    .challenge-page {
      padding: 3rem 1rem;
    }

    .section-head {
      margin-bottom: 1.25rem;
    }

    .section-head .h2 {
      margin-bottom: 0.75rem;
    }

    .lead {
      max-width: 34rem;
      font-size: 1rem;
      line-height: 1.5;
    }

    .carousel {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
    }

    .carousel__viewport {
      grid-column: 1 / -1;
      grid-row: 1;
      padding: 0.5rem 0 0.75rem;
    }

    .carousel__pagination {
      grid-column: 2;
      grid-row: 2;
      padding: 0;
    }

    .challenge-grid {
      align-items: flex-start;
    }

    .challenge-card {
      align-self: flex-start;
      min-height: 0;
      padding: 1.25rem;
      border-radius: 16px;
    }

    .challenge-card__head {
      flex-direction: column-reverse;
      align-items: stretch;
      gap: 0.5rem;
      margin-bottom: 0.85rem;
    }

    .challenge-card__logo {
      align-self: center;
    }

    .challenge-card h2 {
      max-width: none;
      font-size: 1.05rem;
      line-height: 1.4;
    }

    .challenge-card p {
      font-size: 0.95rem;
      line-height: 1.55;
    }

    .challenge-card__logo--wide { width: 104px; height: 52px; }
    .challenge-card__logo--nos { width: 112px; height: 60px; }
    .challenge-card__logo--square { width: 60px; height: 60px; }

    .carousel__btn {
      position: relative;
      top: auto;
      transform: none;
      grid-row: 2;
      width: 40px;
      height: 40px;
    }

    .carousel__btn:hover {
      transform: scale(1.05);
    }

    .carousel__btn--prev {
      grid-column: 1;
      justify-self: start;
    }

    .carousel__btn--next {
      grid-column: 3;
      justify-self: end;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .challenge-card,
    .carousel__btn,
    .carousel__dot {
      transition: none;
    }
  }
</style>

<script>
  const AUTOPLAY_MS = 3000;  // time between slides
  const SLIDE_MS = 700;      // slide animation duration

  const track = document.getElementById("carousel-track");
  const carousel = document.getElementById("carousel");
  const prev = carousel?.querySelector<HTMLButtonElement>(".carousel__btn--prev");
  const next = carousel?.querySelector<HTMLButtonElement>(".carousel__btn--next");
  const dots = carousel?.querySelectorAll<HTMLButtonElement>("[data-carousel-dot]");

  if (track && carousel && prev && next && dots) {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const duration = reduceMotion ? 0 : SLIDE_MS;
    const challengeCount = track.children.length;
    let animating = false;
    let navigatingToDot = false;
    let activeIndex = 0;

    const updateDots = () => {
      dots.forEach((dot) => {
        if (Number(dot.dataset.carouselDot) === activeIndex) {
          dot.setAttribute("aria-current", "true");
        } else {
          dot.removeAttribute("aria-current");
        }
      });
    };

    const step = () => {
      const card = track.firstElementChild as HTMLElement;
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return card.offsetWidth + gap;
    };

    const goNext = () => {
      if (animating) return false;
      animating = true;
      activeIndex = (activeIndex + 1) % challengeCount;
      updateDots();
      track.style.transition = `transform ${duration}ms ease`;
      track.style.transform = `translateX(${-step()}px)`;

      setTimeout(() => {
        // Move the first card to the end, then reset position invisibly
        track.style.transition = "none";
        track.appendChild(track.firstElementChild!);
        track.style.transform = "translateX(0)";
        track.getBoundingClientRect(); // force reflow
        animating = false;
      }, duration);
      return true;
    };

    const goPrev = () => {
      if (animating) return false;
      animating = true;
      activeIndex = (activeIndex - 1 + challengeCount) % challengeCount;
      updateDots();
      // Move the last card to the front, offset so nothing visibly jumps
      track.style.transition = "none";
      track.insertBefore(track.lastElementChild!, track.firstElementChild);
      track.style.transform = `translateX(${-step()}px)`;
      track.getBoundingClientRect(); // force reflow

      track.style.transition = `transform ${duration}ms ease`;
      track.style.transform = "translateX(0)";
      setTimeout(() => { animating = false; }, duration);
      return true;
    };

    const goTo = (index: number) => {
      if (navigatingToDot || index === activeIndex) return;
      stop();
      navigatingToDot = true;

      const forwardSteps = (index - activeIndex + challengeCount) % challengeCount;
      const backwardSteps = (activeIndex - index + challengeCount) % challengeCount;
      const direction = forwardSteps <= backwardSteps ? 1 : -1;
      let remaining = Math.min(forwardSteps, backwardSteps);

      const moveNext = () => {
        if (remaining === 0) {
          navigatingToDot = false;
          start();
          return;
        }

        const moved = direction === 1 ? goNext() : goPrev();
        if (!moved) {
          window.setTimeout(moveNext, 20);
          return;
        }

        remaining -= 1;
        window.setTimeout(moveNext, duration + 20);
      };

      moveNext();
    };

    // Autoplay
    let timer: number | undefined;
    const stop = () => window.clearInterval(timer);
    const start = () => {
      stop();
      timer = window.setInterval(goNext, AUTOPLAY_MS);
    };

    next.addEventListener("click", () => {
      if (navigatingToDot) return;
      goNext();
      start();
    });
    prev.addEventListener("click", () => {
      if (navigatingToDot) return;
      goPrev();
      start();
    });
    dots.forEach((dot) => {
      dot.addEventListener("click", () => goTo(Number(dot.dataset.carouselDot)));
    });

    // Pause while the user is interacting
    carousel.addEventListener("mouseenter", stop);
    carousel.addEventListener("mouseleave", start);
    carousel.addEventListener("focusin", stop);
    carousel.addEventListener("focusout", start);

    // Swipe support (a swipe must not open the PDF)
    let startX = 0;
    let swiped = false;
    carousel.addEventListener("pointerdown", (e) => {
      startX = e.clientX;
      swiped = false;
      stop();
    });
    carousel.addEventListener("pointerup", (e) => {
      const dx = e.clientX - startX;
      if (navigatingToDot) return;
      if (Math.abs(dx) > 50) {
        swiped = true;
        dx < 0 ? goNext() : goPrev();
      }
      start();
    });
    track.addEventListener("click", (e) => {
      if (swiped) {
        e.preventDefault();
        swiped = false;
      }
    });

    // Don't run in background tabs
    document.addEventListener("visibilitychange", () => {
      document.hidden ? stop() : start();
    });

    start();
  }
</script>