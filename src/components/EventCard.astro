---
// Card for an archived edition, used on the Past Events page and the homepage.
import type { PastEvent } from '../data/events';

interface Props {
  event: PastEvent;
  /** Heading level for the event title, so the page outline stays correct. */
  headingLevel?: 2 | 3;
}

const { event, headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const titleId = `event-${event.year}-title`;
const coverStyle = `--cover-bg: ${event.theme.background}; --cover-accent: ${event.theme.accent};`;
---

<article class="event-card" aria-labelledby={titleId}>
  {
    event.image ? (
      <a href={event.href} class="event-card__media" tabindex="-1" aria-hidden="true">
        <img
          src={event.image.src}
          alt=""
          width={event.image.width}
          height={event.image.height}
          loading="lazy"
          decoding="async"
        />
      </a>
    ) : (
      <a href={event.href} class="event-card__media event-card__cover" style={coverStyle} tabindex="-1" aria-hidden="true">
        {event.coverMark && <img class="event-card__cover-mark" src={event.coverMark} alt="" loading="lazy" />}
        <span class="event-card__cover-label">{event.editionLabel}</span>
        <span class="event-card__cover-year">{event.year}</span>
      </a>
    )
  }

  <div class="event-card__body">
    <p class="event-card__meta">
      <span class="event-card__status">Concluded</span>
      <span>
        <span class="event-card__edition">{event.editionLabel}</span>
        <span aria-hidden="true"> · </span>
        <span class="visually-hidden">, </span>
        <time datetime={event.startDate}>{event.dateLabel}</time>
        <span aria-hidden="true"> · </span>
        <span class="visually-hidden">, </span>
        {event.location}
      </span>
    </p>

    <Heading id={titleId} class="event-card__title">
      <a href={event.href}>{event.title}</a>
    </Heading>

    <p class="event-card__summary">{event.summary}</p>

    {
      event.facts.length > 0 && (
        <dl class="event-card__facts">
          {event.facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))}
        </dl>
      )
    }

    <p class="event-card__links">
      <a href={event.href} class="link-arrow">
        View the {event.year} archive
      </a>
      {
        event.links?.map((link) => (
          <a href={link.href} class="link-arrow">
            {link.label}
          </a>
        ))
      }
    </p>
  </div>
</article>

<style>
  .event-card {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: start;
  }

  @media (min-width: 52rem) {
    .event-card {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    }
  }

  .event-card__media {
    display: block;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-raised);
  }

  .event-card__media > img:not(.event-card__cover-mark) {
    width: 100%;
    height: auto;
    transition: transform 0.4s ease;
  }

  .event-card__media:hover img {
    transform: scale(1.02);
  }

  /* Typographic cover for editions without their own photographs. */
  .event-card__cover {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    aspect-ratio: 4 / 3;
    padding: clamp(1.25rem, 3vw, 2rem);
    background:
      radial-gradient(120% 90% at 100% 0%, color-mix(in srgb, var(--cover-accent) 28%, transparent), transparent 60%),
      var(--cover-bg);
    text-decoration: none;
  }

  .event-card__cover-mark {
    position: absolute;
    top: clamp(1.25rem, 3vw, 2rem);
    right: clamp(1.25rem, 3vw, 2rem);
    width: clamp(3.5rem, 9vw, 5.5rem);
    height: auto;
    opacity: 0.9;
  }

  .event-card__cover-label {
    color: var(--cover-accent);
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .event-card__cover-year {
    margin-top: 0.25rem;
    color: var(--text);
    font-size: clamp(3.5rem, 10vw, 6rem);
    font-weight: 600;
    letter-spacing: -0.06em;
    line-height: 0.9;
  }

  .event-card__edition {
    color: var(--text);
  }

  .event-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.9rem;
    color: var(--text-muted);
    font-family: var(--mono);
    font-size: 0.8125rem;
  }

  .event-card__status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    color: var(--text);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .event-card__status::before {
    content: '';
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--text-subtle);
  }

  .event-card__title {
    margin-top: 1.1rem;
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    letter-spacing: -0.035em;
  }

  .event-card__title a {
    text-decoration: none;
  }

  .event-card__title a:hover {
    color: var(--accent);
  }

  .event-card__summary {
    margin-top: 0.9rem;
    color: var(--text-muted);
  }

  .event-card__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 1rem 1.5rem;
    margin: 1.75rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .event-card__facts dt {
    color: var(--text-subtle);
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .event-card__facts dd {
    margin: 0.3rem 0 0;
    color: var(--text);
    font-size: 0.975rem;
    font-weight: 500;
  }

  .event-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
    margin-top: 1.75rem;
  }
</style>
