---
// Title block at the top of inner pages (News, Past Events, Privacy, ...).
interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
}

const { title, eyebrow, lead } = Astro.props;
---

<div class="page-header">
  <div class="container">
    {eyebrow && <p class="eyebrow eyebrow--accent">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="page-header__lead">{lead}</p>}
    <slot />
  </div>
</div>
