---
// <head> contents for the evergreen site: title, description, canonical URL,
// Open Graph / Twitter previews, favicon and self-hosted fonts.
import { Font } from 'astro:assets';
import { SITE } from '../data/site';
import '../styles/global.css';

export interface Props {
  /**
   * Page title. Omit on the homepage. " · JunctionX Lisbon" is appended unless the
   * title already names the site (e.g. "JunctionX Lisbon 2026 Winners").
   */
  title?: string;
  description?: string;
  image?: { src: string; alt: string; width?: number; height?: number };
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  image = SITE.defaultImage,
  type = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
} = Astro.props;

const fullTitle = !title ? SITE.name : title.includes(SITE.name) ? title : `${title} · ${SITE.name}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
// Link-preview crawlers (WhatsApp, LinkedIn, ...) need absolute image URLs.
const imageUrl = new URL(image.src, Astro.site).href;
// Small images (such as the default emblem) look better as a compact card.
const isSmallImage = image.src === SITE.defaultImage.src || (image.width !== undefined && image.width < 600);
const twitterCard = isSmallImage ? 'summary' : 'summary_large_image';
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<title>{fullTitle}</title>
<meta name="description" content={description} />
{/* Pages that should not be indexed (404, drafts) get no canonical URL. */}
{!noindex && <link rel="canonical" href={canonicalUrl} />}
{noindex && <meta name="robots" content="noindex" />}

<link rel="icon" type="image/png" href="/assets/junctionx-logo.png" />
<link rel="apple-touch-icon" href="/assets/junctionx-logo.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta name="theme-color" content="#0b0c11" />
<meta name="color-scheme" content="dark" />
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-sans" preload />
<Font cssVariable="--font-mono" />

<!-- Open Graph / Facebook / LinkedIn / WhatsApp / Discord -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content="en_GB" />
{!noindex && <meta property="og:url" content={canonicalUrl} />}
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={image.alt} />
{image.width && <meta property="og:image:width" content={String(image.width)} />}
{image.height && <meta property="og:image:height" content={String(image.height)} />}
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<!-- Twitter / X -->
<meta name="twitter:card" content={twitterCard} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={image.alt} />
