---
import SiteLayout from '../layouts/SiteLayout.astro';
import NewsCard from '../components/NewsCard.astro';
import { getPastEvents } from '../data/events';
import { SITE, SOCIAL_LINKS } from '../data/site';
import { getNews } from '../lib/news';

const pastEvents = getPastEvents();
const latestEvent = pastEvents[0];
const foundingEvent = pastEvents.at(-1);
const latestNews = (await getNews()).slice(0, 3);

const community = [
  {
    name: 'Students',
    text: 'From any university or field of study, learning by building alongside others.',
  },
  {
    name: 'Developers',
    text: 'Engineers and designers who want to prototype quickly and try new tools.',
  },
  {
    name: 'Researchers',
    text: 'Academics who want to see ideas tested against concrete, real-world problems.',
  },
  {
    name: 'Mentors',
    text: 'Experienced practitioners who guide teams through technical and product decisions.',
  },
  {
    name: 'Partners',
    text: 'Companies and organisations that bring real challenges, expertise and support.',
  },
];

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: Astro.site?.href,
  logo: new URL(SITE.defaultImage.src, Astro.site).href,
  email: SITE.email,
  description: SITE.description,
  sameAs: SOCIAL_LINKS.map((link) => link.href),
};
---

<SiteLayout>
  <Fragment slot="head">
    <!--
      The 2025 and 2026 event websites used to live at this URL. Forward old shared links
      such as lisbon.hackjunction.com/#challenges to the same section of the right archive.
    -->
    <script is:inline>
      (function () {
        var legacy = {
          prizes: '/past-events/2026/#prizes',
          sponsors: '/past-events/2026/#sponsors',
          challenges: '/past-events/2026/#challenges',
          location: '/past-events/2026/#location',
          faq: '/past-events/2026/#faq',
          'our-team': '/past-events/2026/#our-team',
          partners: '/past-events/2025/#partners',
          collab: '/past-events/2025/#partners',
          register: '/past-events/2025/',
        };
        var target = legacy[window.location.hash.slice(1)];
        if (target) window.location.replace(target);
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
  </Fragment>

  <section class="hero" aria-labelledby="hero-title">
    <div class="container">
      <p class="hero__brand">
        <img src="/assets/junctionx-banner.png" alt="JunctionX" width="926" height="123" />
        <span>Lisbon</span>
      </p>

      <h1 id="hero-title" class="hero__title">Building what’s next.</h1>

      <p class="hero__lead">
        A community bringing together students, developers, researchers and companies to build
        innovative solutions through hackathons and collaborative projects.
      </p>
      <p class="hero__note">A permanent home for the JunctionX Lisbon initiative.</p>

      <div class="hero__actions">
        <a class="button" href="/past-events/">Explore past events</a>
        <a class="button button--quiet" href="/news/">Read the news</a>
      </div>

      <dl class="hero__facts">
        <div>
          <dt>Based in</dt>
          <dd>Lisbon, Portugal</dd>
        </div>
        {
          foundingEvent && (
            <div>
              <dt>Founded</dt>
              <dd>
                <a href={foundingEvent.href}>{foundingEvent.year}</a>
              </dd>
            </div>
          )
        }
        {
          latestEvent && (
            <div>
              <dt>Latest edition</dt>
              <dd>
                <a href={latestEvent.href}>{latestEvent.title}</a>
              </dd>
            </div>
          )
        }
        <div>
          <dt>Contact</dt>
          <dd>
            <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section" id="about" aria-labelledby="about-title">
    <div class="container section-grid">
      <p class="eyebrow section-label"><span>01</span> About</p>
      <div>
        <h2 id="about-title" class="section-title">More than a weekend.</h2>
        <div class="about__text">
          <p>
            JunctionX Lisbon is the Lisbon home of JunctionX, the international hackathon series by
            Junction. Since its founding edition in 2025, it has brought together students,
            developers, researchers and companies to work on real challenges and turn ideas into
            working prototypes.
          </p>
          <p>
            Each hackathon is a chapter in a longer story. This website keeps that story in one
            place: what is happening now, and a permanent record of past editions, with their
            challenges, partners, people and projects.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="community" aria-labelledby="community-title">
    <div class="container section-grid">
      <p class="eyebrow section-label"><span>02</span> Community</p>
      <div>
        <h2 id="community-title" class="section-title">Who it brings together</h2>
        <p class="section-intro">
          JunctionX Lisbon is for people who like to make things, whatever their background.
        </p>

        <ul class="community" role="list">
          {
            community.map((group) => (
              <li class="community__item">
                <h3 class="community__name">{group.name}</h3>
                <p class="community__text">{group.text}</p>
              </li>
            ))
          }
        </ul>

        <p class="community__cta">
          Want to take part, mentor, partner or help organise a future edition? Write to{' '}
          <a class="text-link" href={`mailto:${SITE.email}`}>{SITE.email}</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="section" id="past-events" aria-labelledby="past-events-title">
    <div class="container section-grid">
      <p class="eyebrow section-label"><span>03</span> Past events</p>
      <div>
        <h2 id="past-events-title" class="section-title">Every edition, on the record.</h2>
        <p class="section-intro">
          Each edition is a chapter in the history of JunctionX Lisbon, archived with its
          challenges, partners, team and winners.
        </p>

        <ol class="chapters" role="list">
          {
            pastEvents.map((event) => (
              <li class="chapter" style={`--chapter-accent: ${event.theme.accent}`}>
                <p class="chapter__year">{event.year}</p>
                <div>
                  <p class="chapter__meta">
                    <span class="chapter__label">{event.editionLabel}</span>
                    <span aria-hidden="true"> · </span>
                    <time datetime={event.startDate}>{event.dateLabel}</time>
                    <span aria-hidden="true"> · </span>
                    {event.location}
                  </p>
                  <h3 class="chapter__title">
                    <a href={event.href}>{event.title}</a>
                  </h3>
                  <p class="chapter__summary">{event.summary}</p>
                </div>
              </li>
            ))
          }
        </ol>

        <p class="section-footer">
          <a class="link-arrow" href="/past-events/">All past events</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section" id="news" aria-labelledby="news-title">
    <div class="container section-grid">
      <p class="eyebrow section-label"><span>04</span> News</p>
      <div>
        <h2 id="news-title" class="section-title">Latest announcements</h2>

        {
          latestNews.length > 0 ? (
            <div class="home-news">
              {latestNews.map((entry) => (
                <NewsCard entry={entry} headingLevel={3} />
              ))}
            </div>
          ) : (
            <p class="section-intro">
              There are no announcements yet. News and updates from the JunctionX Lisbon team will
              appear here.
            </p>
          )
        }

        <p class="section-footer">
          <a class="link-arrow" href="/news/">All news</a>
        </p>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4.5rem, 12vw, 9rem) clamp(3.5rem, 8vw, 5.5rem);
  }

  /* A single, very soft glow in the brand lavender. */
  .hero::before {
    content: '';
    position: absolute;
    top: -18rem;
    right: -16rem;
    width: 52rem;
    height: 40rem;
    background: radial-gradient(closest-side, rgb(189 189 255 / 0.09), transparent);
    pointer-events: none;
  }

  .hero .container {
    position: relative;
  }

  .hero__brand {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .hero__brand img {
    width: auto;
    height: clamp(1.05rem, 2.1vw, 1.5rem);
  }

  .hero__brand span {
    color: var(--text);
    font-family: var(--mono);
    font-size: clamp(0.8rem, 1.4vw, 1.05rem);
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .hero__title {
    max-width: 12ch;
    margin-top: clamp(1.75rem, 4vw, 2.75rem);
    font-size: clamp(3rem, 9vw, 7rem);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  .hero__lead {
    max-width: 38rem;
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    color: var(--text-muted);
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    line-height: 1.55;
  }

  .hero__note {
    margin-top: 1rem;
    color: var(--text-subtle);
    font-family: var(--mono);
    font-size: 0.8125rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .hero__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1.25rem 2rem;
    margin: clamp(3.5rem, 8vw, 5.5rem) 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .hero__facts dt {
    color: var(--text-subtle);
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero__facts dd {
    margin: 0.35rem 0 0;
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .hero__facts a {
    text-decoration: none;
  }

  .hero__facts a:hover {
    color: var(--accent);
  }

  /* ---------- Sections ---------- */
  .section-label span {
    margin-right: 0.6rem;
    color: var(--accent);
  }

  .about__text {
    display: grid;
    gap: 1.25rem;
    max-width: 42rem;
    margin-top: 1.5rem;
    color: var(--text-muted);
    font-size: clamp(1.0625rem, 1.5vw, 1.1875rem);
  }

  .community {
    margin-top: 2.5rem;
    border-bottom: 1px solid var(--border);
  }

  .community__item {
    display: grid;
    gap: 0.35rem 2rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--border);
  }

  @media (min-width: 40rem) {
    .community__item {
      grid-template-columns: 11rem 1fr;
      align-items: baseline;
    }
  }

  .community__name {
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
  }

  .community__text {
    color: var(--text-muted);
  }

  .community__cta {
    max-width: 40rem;
    margin-top: 2rem;
    color: var(--text-muted);
  }

  .chapters {
    margin-top: 2.5rem;
    border-bottom: 1px solid var(--border);
  }

  .chapter {
    position: relative;
    display: grid;
    gap: 0.5rem 2rem;
    padding-block: 1.75rem;
    border-top: 1px solid var(--border);
  }

  @media (min-width: 40rem) {
    .chapter {
      grid-template-columns: 6rem 1fr;
    }
  }

  .chapter__year {
    color: var(--chapter-accent);
    font-family: var(--mono);
    font-size: 1.125rem;
    font-weight: 500;
  }

  .chapter__meta {
    color: var(--text-subtle);
    font-family: var(--mono);
    font-size: 0.8125rem;
  }

  .chapter__label {
    color: var(--text);
  }

  .chapter__title {
    margin-top: 0.5rem;
    font-size: clamp(1.35rem, 2.6vw, 1.75rem);
    letter-spacing: -0.03em;
  }

  .chapter__title a {
    text-decoration: none;
  }

  /* The whole row is clickable. */
  .chapter__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .chapter:hover .chapter__title a {
    color: var(--accent);
  }

  .chapter__summary {
    max-width: 40rem;
    margin-top: 0.5rem;
    color: var(--text-muted);
  }

  .home-news {
    margin-top: 1.5rem;
    border-bottom: 1px solid var(--border);
  }
</style>
