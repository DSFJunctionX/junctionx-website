---
// Archive of JunctionX Lisbon 2025, the founding edition.
// Content recovered from the original 2025 website (`website-2025` branch); see
// src/data/editions/2025.ts. Results are based on the external sources cited.
import EditionLayout from '../../../layouts/EditionLayout.astro';
import EditionSection from '../../../components/edition/EditionSection.astro';
import ChallengeList from '../../../components/edition/ChallengeList.astro';
import PartnerGrid from '../../../components/edition/PartnerGrid.astro';
import Programme from '../../../components/edition/Programme.astro';
import TeamList from '../../../components/edition/TeamList.astro';
import FaqList from '../../../components/edition/FaqList.astro';
import WinnerFeature from '../../../components/edition/WinnerFeature.astro';
import ResourceList from '../../../components/edition/ResourceList.astro';
import VideoFigure from '../../../components/edition/VideoFigure.astro';
import LogoTile from '../../../components/edition/LogoTile.astro';
import { getEvent } from '../../../data/events';
import { SITE } from '../../../data/site';
import {
  challenges2025,
  faq2025,
  highlights2025,
  organiser2025,
  partners2025,
  programme2025,
  resources2025,
  team2025,
  themes2025,
  winnerSources2025,
} from '../../../data/editions/2025';

const event = getEvent(2025);

const nav = [
  { href: '#about', label: 'About' },
  { href: '#winners', label: 'Winners' },
  { href: '#challenges', label: 'Challenges' },
  { href: '#partners', label: 'Partners' },
  { href: '#programme', label: 'Programme' },
  { href: '#organisers', label: 'Organisers' },
  { href: '#faq', label: 'FAQ' },
  { href: '#media', label: 'Media' },
  { href: '#resources', label: 'Resources' },
];
---

<EditionLayout
  event={event}
  nav={nav}
  title="JunctionX Lisbon 2025 · Founding Edition"
  description="Archive of JunctionX Lisbon 2025, the founding edition: a 36-hour hackathon held on 18–19 October 2025 at Técnico’s Oeiras campus, with challenges from Glintt, Albatroz Engenharia and the Gulbenkian Institute for Molecular Medicine."
>
  <p slot="brand" class="lockup-2025" aria-hidden="true">
    Junction<img src="/assets/junctionx-wordmark-small.png" alt="" width="108" height="108" />Lisbon
  </p>

  <Fragment slot="actions">
    <a class="button" href="#winners">Meet the winners</a>
    <a class="link-arrow" href="#challenges">Explore the challenges</a>
  </Fragment>

  <EditionSection id="about" label="About" title="What was JunctionX Lisbon 2025?">
    <div class="about-2025">
      <div class="prose">
        <p>
          An international 36-hour hackathon where teams of one to five people worked on technology
          projects with real-world impact. Participants chose from challenges set by partner
          companies and institutions, focusing on areas such as:
        </p>
        <ul>
          {themes2025.map((theme) => <li>{theme}</li>)}
        </ul>
        <p>
          As the founding edition, it brought Junction, Europe’s hackathon series, to Lisbon for the
          first time. The winners earned tickets to <a href="https://hackjunction.com" target="_blank" rel="noopener noreferrer">Junction</a> in Finland.
        </p>
      </div>

      <dl class="highlights">
        {
          highlights2025.map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))
        }
      </dl>

      <div class="organiser">
        <LogoTile logo={organiser2025.logo} alt={organiser2025.name} size="sm" />
        <p>
          <span class="eyebrow">Organised by</span>
          {organiser2025.description}
        </p>
      </div>
    </div>
  </EditionSection>

  <EditionSection
    id="winners"
    label="Winners"
    title="The first winners"
    intro="The original website was last updated before the event. The results below come from coverage by Técnico, DEI and RTP, listed under Sources."
  >
    <WinnerFeature
      team="Três Mosqueteiros"
      result="1st place · General and Peer Review categories"
      members={['Duarte Pereira da Cruz', 'Daniel Borges', 'André Pagaime']}
      membersNote="Computer Science and Engineering undergraduates at Técnico"
      prize="€500 and a place at Junction 2025 in Finland"
      sources={winnerSources2025}
    >
      <p>
        The team took on Albatroz Engenharia’s challenge with an AI tool that uses satellite imagery
        and georeferenced data to identify and predict the spread of invasive <em>Acacia</em> species
        in Portugal.
      </p>
      <p class="winner-note">
        Técnico’s event report names the project <em>Chega d’Acácias</em>; its December 2025 article
        calls it <em>Forest Guardian</em>, an AI system that detects invasive acacias in drone and
        satellite imagery.
      </p>

      <h3>From Lisbon to Espoo</h3>
      <p>
        Winning JunctionX Lisbon took the team to Junction 2025 in Espoo, Finland, held from 14 to 16
        November 2025 under the theme <em>Utopia &amp; Dystopia</em>. There they built{' '}
        <strong>BetterMeeting</strong>, an AI meeting assistant for Snap’s Spectacles
        augmented-reality glasses, with real-time subtitles, transcripts, meeting summaries, automatic
        task extraction and a “podcast mode”, using ElevenLabs and Google Gemini. The project
        entered challenges run by Snapchat, Google and ElevenLabs.
      </p>
      <p>
        On 18 November 2025, Antena 1’s programme <em>Duas de Prosa</em> (RTP) dedicated an episode
        to the students’ trip. Two of the team, Daniel Borges and Duarte Pereira da Cruz, went on to
        lead the organisation of <a href="/past-events/2026/#our-team">JunctionX Lisbon 2026</a>.
      </p>
      <p><a href="/news/first-winners-at-junction-2025/">Read the full story in News</a></p>
    </WinnerFeature>
  </EditionSection>

  <EditionSection
    id="challenges"
    label="Challenges"
    title="What teams could build"
    intro="Three challenges set by industry and research partners."
  >
    <ChallengeList challenges={challenges2025} />
  </EditionSection>

  <EditionSection id="partners" label="Partners" title="Partners">
    <PartnerGrid groups={partners2025} />
  </EditionSection>

  <EditionSection id="programme" label="Programme" title="Schedule">
    <Programme days={programme2025} utcOffset="+01:00" />
  </EditionSection>

  <EditionSection
    id="organisers"
    label="Organisers"
    title="Meet the team"
    intro="The people behind the founding edition of JunctionX Lisbon."
  >
    <TeamList members={team2025} />
    <p class="organisers-note">
      The original website also invited companies to become partners and people to join as
      volunteers, through <a class="text-link" href={`mailto:${SITE.email}`}>{SITE.email}</a>, which
      remains the contact for JunctionX Lisbon.
    </p>
  </EditionSection>

  <EditionSection
    id="faq"
    label="FAQ"
    title="Frequently asked questions"
    intro="As published for participants before the event."
  >
    <FaqList items={faq2025} />
  </EditionSection>

  <EditionSection id="media" label="Media" title="Video and photos">
    <div class="media-2025">
      <VideoFigure
        src="/assets/video.mp4"
        poster="/assets/2025/video-poster.jpg"
        caption="Promotional video featured on the original JunctionX Lisbon 2025 website (and reused on the 2026 website)."
      />
      <a
        class="gallery-link"
        href="https://gallery.tecnico.ulisboa.pt/s/n988yy8yai/junctionx-lisbon-2025"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="eyebrow">Photo gallery</span>
        <span class="gallery-link__title">Photographs of JunctionX Lisbon 2025</span>
        <span class="gallery-link__text">Published by Técnico on its photo gallery. Opens on gallery.tecnico.ulisboa.pt.</span>
        <span class="gallery-link__arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </EditionSection>

  <EditionSection id="resources" label="Resources" title="Documents and links">
    <ResourceList resources={resources2025} />
  </EditionSection>
</EditionLayout>

<style>
  /* The 2025 wordmark: "Junction ✕ Lisbon", as on the original website. */
  .lockup-2025 {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text);
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    font-weight: 400;
    letter-spacing: 0.32em;
    text-transform: uppercase;
  }

  .lockup-2025 img {
    width: auto;
    height: 1.6em;
  }

  .about-2025 {
    display: grid;
    gap: clamp(2rem, 5vw, 3rem);
  }

  .highlights {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1px;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--border);
  }

  .highlights div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.4rem;
    padding: 1.25rem 1.4rem;
    background: var(--bg);
  }

  .highlights dd {
    margin: 0;
    color: var(--text);
    font-size: clamp(1.75rem, 4vw, 2.4rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .highlights dt {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .organiser {
    display: grid;
    gap: 1rem 1.5rem;
    align-items: center;
    max-width: 44rem;
  }

  @media (min-width: 40rem) {
    .organiser {
      grid-template-columns: 13rem 1fr;
    }
  }

  .organiser p {
    display: grid;
    gap: 0.3rem;
    color: var(--text-muted);
  }

  .winner-note {
    font-size: 0.95rem;
    color: var(--text-subtle);
  }

  .organisers-note {
    max-width: 42rem;
    margin-top: 1.5rem;
    color: var(--text-muted);
    font-size: 0.9375rem;
  }

  .media-2025 {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 60rem) {
    .media-2025 {
      grid-template-columns: 2fr 1fr;
      align-items: start;
    }
  }

  .gallery-link {
    position: relative;
    display: grid;
    gap: 0.5rem;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .gallery-link:hover {
    border-color: var(--border-strong);
    background: var(--bg-raised);
  }

  .gallery-link__title {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .gallery-link__text {
    color: var(--text-muted);
    font-size: 0.9375rem;
  }

  .gallery-link__arrow {
    position: absolute;
    top: 1.25rem;
    right: 1.5rem;
    color: var(--text-subtle);
  }
</style>
