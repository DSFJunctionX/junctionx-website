---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<SiteLayout
  title="Page not found"
  description="The page you were looking for could not be found."
  noindex
>
  <PageHeader
    eyebrow="Error 404"
    title="Page not found"
    lead="The page you were looking for doesn’t exist or has moved. Pages from JunctionX Lisbon 2026 now live in the past events archive."
  >
    <div class="not-found__actions">
      <a class="button" href="/">Go to the homepage</a>
      <a class="button button--quiet" href="/past-events/">Browse past events</a>
    </div>
  </PageHeader>
</SiteLayout>

<style>
  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
    padding-bottom: var(--section-space);
  }
</style>
