---
// Privacy policy. Describes how this website handles visitor data.
// Keep it accurate whenever third-party services are added to the site.
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { SITE } from '../../data/site';

const lastUpdated = { iso: '2026-11-08', label: '8 November 2026' };
---

<SiteLayout
  title="Privacy Policy"
  description="How the JunctionX Lisbon website handles your information."
>
  <PageHeader title="Privacy policy" lead="How this website handles your information.">
    <p class="privacy__updated">
      Last updated <time datetime={lastUpdated.iso}>{lastUpdated.label}</time>
    </p>
  </PageHeader>

  <div class="container privacy">
    <div class="prose">
      <h2>Who we are</h2>
      <p>
        This website is run by the JunctionX Lisbon organising team. If you have any question
        about privacy or your personal data, contact us at{' '}
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
      </p>

      <h2>What this website collects</h2>
      <p>
        This is a static website. We do not use analytics, advertising trackers or our own
        cookies, and the site has no forms or user accounts. We do not collect personal
        information through it.
      </p>

      <h2>Hosting</h2>
      <p>
        The website is hosted on GitHub Pages. To deliver pages, GitHub may process technical
        information such as your IP address, as described in GitHub's privacy statement.
      </p>

      <h2>Third-party content</h2>
      <p>
        The <a href="/past-events/2026/">JunctionX Lisbon 2026 archive</a> embeds a Google Maps
        map of the venue and loads a typeface from Google Fonts. When you open that page, your
        browser connects to Google, which may receive your IP address and set cookies in line with
        Google's privacy policy.
      </p>
      <p>
        Links to external services, such as LinkedIn, Instagram, Discord and the Junction platform
        (hackjunction.app), lead to sites with their own privacy policies.
      </p>

      <h2>Contact</h2>
      <p>
        For questions or requests about your data, email{' '}
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
      </p>
    </div>
  </div>
</SiteLayout>

<style>
  .privacy {
    padding-bottom: var(--section-space);
  }

  .privacy .prose > h2:first-child {
    margin-top: 0;
  }

  .privacy__updated {
    margin-top: 1rem;
    color: var(--text-subtle);
    font-family: var(--mono);
    font-size: 0.8125rem;
  }
</style>
